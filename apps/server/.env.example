SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/photon   (default: SQLite db.sqlite3)
# Fernet key for API keys at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
